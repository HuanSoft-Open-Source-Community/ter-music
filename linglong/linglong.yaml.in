# SPDX-License-Identifier: LGPL-3.0-or-later
#
# Linyaps 模板：build-linyaps.sh 会把它复制到 .tmp 工作目录，替换
# @VERSION@ / @ARCH@ 后再交给 ll-builder。模板本身不直接参与构建。
version: "1"

package:
  id: cn.org.huansoft.ter-music
  name: ter-music
  version: @VERSION@
  kind: app
  description: |
    ter-music 是一个基于 ncurses 的轻量级终端音乐播放器
  architecture: @ARCH@

command:
  - /opt/apps/cn.org.huansoft.ter-music/files/bin/ter-music

base: org.deepin.base/25.2.2

sources:
  - kind: file
    name: ter-music
    url: ./ter-music

build: |
  cd ter-music
  # 内置消音模型（UVR-MDX-NET 3 / 9662）已由 scripts/build/build-linyaps.sh
  # 从 .tmp/models 缓存复制进源码树的 bundled-model/，随 linyaps 源码一起进入
  # 构建容器；这里用 CMake 注入并在安装后自检大小 + SHA256 + NOTICE。
  BUNDLED_MODEL="$PWD/bundled-model/UVR_MDXNET_3_9662.onnx"
  if [ ! -f "$BUNDLED_MODEL" ]; then
    echo "missing bundled karaoke model: $BUNDLED_MODEL" >&2
    echo "build with scripts/build/build-linyaps.sh (tm_ensure_model downloads it)" >&2
    exit 1
  fi
  mkdir -p build
  cd build
  cmake .. -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=${PREFIX} \
    -DCMAKE_INSTALL_RPATH='$ORIGIN/../lib' \
    -DTER_MUSIC_VERSION=@VERSION@ \
    -DTER_MUSIC_BUNDLED_MODEL="$BUNDLED_MODEL" \
    -DINSTALL_LINYAPS_INTEGRATION=ON
  make -j$(nproc)
  make install
  MODEL_DIR="${PREFIX}/share/ter-music/models"
  if [ ! -f "${MODEL_DIR}/uvr-mdxnet-3-9662.onnx" ] || [ ! -f "${MODEL_DIR}/NOTICE.md" ]; then
    echo "bundled model/NOTICE not installed under ${MODEL_DIR}" >&2
    exit 1
  fi
  if [ "$(stat -c %s "${MODEL_DIR}/uvr-mdxnet-3-9662.onnx")" != "29704436" ]; then
    echo "bundled model size mismatch under ${MODEL_DIR}" >&2
    exit 1
  fi
  echo "e02220e80d8253f4c2209f8924298b2b686bbdf2868b788ff5500fb9bd94aadc  ${MODEL_DIR}/uvr-mdxnet-3-9662.onnx" | sha256sum -c - || exit 1
  echo "bundled karaoke model verified: ${MODEL_DIR}/uvr-mdxnet-3-9662.onnx"
  mkdir -p ${PREFIX}/lib
  for dep in libblas.so.3 liblapack.so.3 libmpg123.so.0; do
    dep_path=$(find /usr/lib /lib \( -type f -o -type l \) -name "${dep}" 2>/dev/null | head -n 1)
    if [ -z "${dep_path}" ]; then
      echo "required runtime library not found: ${dep}" >&2
      exit 1
    fi
    install -Dm755 "$(readlink -f "${dep_path}")" "${PREFIX}/lib/${dep}"
  done

buildext:
  apt:
    build_depends:
      - build-essential
      - cmake
      - pkg-config
      - libncurses-dev
      - libavformat-dev
      - libavcodec-dev
      - libswresample-dev
      - libavutil-dev
      - libavfilter-dev
      - libswscale-dev
      - libpng-dev
      - libjpeg-dev
      - libxml2-dev
      - libcurl4-openssl-dev
      - libsqlite3-dev
      - libdbus-1-dev
      - zlib1g-dev
    depends:
      # SMB/CIFS 远程音乐源需要运行时的 smbclient（Samba 客户端）。
      # Linyaps 清单没有“可选/推荐依赖”字段，因此不放进 depends（否则会
      # 强制安装整个 Samba）；由应用在缺 smbclient 时给出安装提示，文档同步。
      - libavformat60
      - libavcodec60
      - libswresample4
      - libavutil58
      - libavfilter9
      - libpulse0
      - libblas3
      - liblapack3
      - libgfortran5
      - libpng16-16
      - libjpeg62-turbo
      - libxml2
      - libcurl4
      - libswscale7
      - libmpg123-0
      - libvorbis0a
      - libvorbisenc2
      - libvorbisfile3
      - libopus0
      - libtheora0
      - libx264-160
      - libx265-199
      - libvpx7
      - libzstd1
      - liblzma5
