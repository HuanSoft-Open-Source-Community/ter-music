# Arch Linux/AUR 构建与验收镜像。默认 USTC 源。
FROM archlinux:latest

# 构建期下载内置消音模型（scripts/build/common.sh tm_ensure_model）：
# aria2c 优先，宿主/镜像缺失时构建脚本回退 curl/wget。

RUN printf '%s\n' \
        'Server = https://mirrors.ustc.edu.cn/archlinux/$repo/os/$arch' \
        > /etc/pacman.d/mirrorlist && \
    pacman-key --init && \
    pacman-key --populate archlinux && \
    pacman -Syu --noconfirm --needed \
        base-devel \
        cmake \
        git \
        pkgconf \
        ffmpeg \
        ncurses \
        libxml2 \
        libpng \
        libjpeg-turbo \
        curl \
        aria2 \
        sqlite \
        zlib \
        dbus \
        rsync \
    && pacman -Scc --noconfirm

RUN useradd -m -u 1000 builder

WORKDIR /workspace
