#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall -Wno-format-truncation -Wno-unused
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# 包版本来自 changelog（构建脚本会在临时副本里按 -v 重写），去掉 Debian 修订号。
VERSION := $(shell dpkg-parsechangelog -SVersion | sed -E 's/-[^-]+$$//')

# Linyaps 目录规范：实体文件全部装在 /opt/apps/<appid>/files 下；
# /usr/bin、/usr/share/applications 与 /usr/share/icons/hicolor 下的
# 符号链接由 debian/links（dh_link）生成，不再出现 /usr 实体文件。
APP_ID := cn.org.huansoft.ter-music
PREFIX := /opt/apps/$(APP_ID)/files

# 内置消音模型（UVR-MDX-NET 3 / 9662）是随包数据文件，不进入 git。
# scripts/build/build-deb.sh 用 tm_ensure_model 下载/校验后把模型放到源码树
# 的 .tm-bundled-model/（staging，构建后清理），并额外用环境变量
# TER_MUSIC_BUNDLED_MODEL 传入绝对路径。环境变量优先；未设置时回退到源码树
# 内路径，使 --with-source 产出的源码包自包含。缺模型时直接失败，避免产出
# 没有内置模型的坏包。
ifeq ($(strip $(TER_MUSIC_BUNDLED_MODEL)),)
TER_MUSIC_BUNDLED_MODEL = $(CURDIR)/.tm-bundled-model/UVR_MDXNET_3_9662.onnx
endif
ifeq ($(wildcard $(TER_MUSIC_BUNDLED_MODEL)),)
$(error 内置模型文件不存在：$(TER_MUSIC_BUNDLED_MODEL)（请用 scripts/build/build-deb.sh 构建，或指定校验过的 UVR_MDXNET_3_9662.onnx 路径）)
endif

%:
	dh $@ --buildsystem=cmake --builddirectory=build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$(PREFIX) \
		-DSTATIC_LINKING=ON \
		-DTER_MUSIC_VERSION=$(VERSION) \
		-DTER_MUSIC_BUNDLED_MODEL=$(TER_MUSIC_BUNDLED_MODEL)

override_dh_auto_test:
	@:

# 跨发行版包名兼容：这些差异是同一个 soname、不同包名。
# libxml2 不在此列：二进制不链接 libxml2，运行期 dlopen .so.2/.so.16，
# 依赖由 debian/control 的 "libxml2 | libxml2-16" 表达。
override_dh_shlibdeps:
	dh_shlibdeps
	# libjpeg: Debian → libjpeg62-turbo, Ubuntu 24.04+ → libjpeg62 (same soname libjpeg.so.62)
	sed -i 's/libjpeg62-turbo[^,]*/libjpeg62-turbo (>= 1.3.1) | libjpeg62/g' debian/*.substvars
	# libpng16: t64 transition — Ubuntu 24.04+ → libpng16-16t64 (same soname libpng16.so.16)
	sed -i 's/libpng16-16[^,]*/libpng16-16 (>= 1.6.2-1) | libpng16-16t64/g' debian/*.substvars
	# libcurl4: t64 transition — Ubuntu 24.04+ → libcurl4t64 (same soname libcurl.so.4)
	sed -i 's/libcurl4[^,]*/libcurl4 (>= 7.16.2) | libcurl4t64/g' debian/*.substvars
